{
  "manifest_version": 3,
  "name": "NOID-B 서플라이허브 연결",
  "version": "1.2.0",
  "description": "쿠팡 Supplier Hub의 WIMS와 상품공급상태 전체 결과를 검증해 NOID-B AI 상품등록으로 전달합니다.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://supplier.coupang.com/qvt/wims*"],
      "js": ["wims-core.js", "supplier-wims.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://supplier.coupang.com/*"],
      "js": ["supply-status-core.js", "supplier-supply-status.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://noidb-os.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["noidb-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
