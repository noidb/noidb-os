{
  "name": "noidb-os",
  "version": "2.0.0",
  "private": true,
  "description": "NOID-B OS",
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:wms-rules && npm run verify:wims-extension && npm run verify:supply-status-extension && npm run verify:registration-idempotency && next build",
    "start": "next start",
    "verify:shipment-split": "npx --yes tsx scripts/verify-shipment-split.ts",
    "verify:wms-order-versioning": "npx --yes tsx scripts/verify-wms-order-versioning.ts",
    "verify:supply-status-safe": "npx --yes tsx scripts/verify-supply-status-safe-updates.ts",
    "verify:wims-registration": "npx --yes tsx scripts/verify-wims-registration.ts",
    "verify:wims-extension": "node scripts/verify-wims-extension.cjs",
    "verify:supply-status-extension": "node scripts/verify-supply-status-extension.cjs",
    "build:supplier-extension": "node scripts/build-supplier-extension.cjs",
    "verify:registration-file-stage": "npx --yes tsx scripts/verify-registration-file-stage.ts",
    "verify:registration-idempotency": "node scripts/verify-registration-idempotency.cjs",
    "verify:safe-product-file-write": "npx --yes tsx scripts/verify-safe-product-file-write.ts",
    "verify:product-label": "npx --yes tsx scripts/verify-product-label.ts",
    "verify:shipment-manifest-order": "npx --yes tsx scripts/verify-shipment-manifest-order.ts",
    "verify:wms-rules": "npx --yes tsx scripts/verify-wms-rules.ts",
    "verify:registration-followups": "npm run verify:product-label && npm run verify:safe-product-file-write && npm run verify:registration-file-stage && npm run verify:registration-idempotency && npm run verify:shipment-manifest-order && npm run verify:wms-rules",
    "coupang:collect": "node automation/coupang-po/collector.mjs --once",
    "coupang:watch": "node automation/coupang-po/collector.mjs --watch",
    "coupang:auto": "node automation/coupang-po/collector.mjs --once",
    "coupang:hanjin": "node automation/coupang-po/hanjin-generator.mjs --force",
    "test:image-generator": "node scripts/test-image-generator.mjs && node scripts/test-quick-draft-cloud.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bwip-js": "^4.5.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "14.2.31",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "typescript": "5.8.2"
  }
}
