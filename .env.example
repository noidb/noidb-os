# NOID-B OS 환경변수 예시 파일
#
# 실제 값은 이 파일에 넣지 않습니다. 이 파일을 복사해 .env.local을 만들고
# 그 안에 실제 값을 채워넣으세요 (.env.local은 .gitignore에 의해 Git에 올라가지 않습니다).
#
#   cp .env.example .env.local      (Windows PowerShell: Copy-Item .env.example .env.local)
#
# 아래 변수들이 없어도 앱은 정상적으로 실행됩니다 — 해당 기능만 "연결 필요/미설정" 상태로
# 안내 화면을 보여줄 뿐, 다른 화면이나 기존 상품등록 기능에는 영향이 없습니다.

# ── 상품등록 자동화 (Google Apps Script 웹훅) ──────────────────────────────
# 없으면: 상품등록 화면에서 구글시트 저장/조회 관련 기능이 "연결 안 됨" 상태로 동작.
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ── AI 사진 분석 / 썸네일 / 소싱 (OpenAI) ──────────────────────────────────
# 없으면: AI 분석·썸네일 생성·소싱 검색 기능이 비활성화된 상태로 동작.
OPENAI_API_KEY=

# ── WMS 발주서 조회/수정 (Google Sheets API, 서비스 계정) ──────────────────
# 없으면: /wms/work-center의 실제 발주서 조회가 "구글시트 연결 필요" 안내를 보여줌.
# 설정 방법: docs/GOOGLE_SHEETS_SETUP.md 참고.
# 2026-08-20부터 이 서비스 계정은 Sheets 전용입니다 — 이미지 업로드에는 쓰이지 않습니다
# (서비스 계정은 Drive 저장 할당량이 0이라 개인 드라이브에 파일을 올릴 수 없습니다).
GOOGLE_SHEETS_WMS_CLIENT_EMAIL=
GOOGLE_SHEETS_WMS_PRIVATE_KEY=
# 선택 — 비워두면 기본 스프레드시트 ID를 코드에서 자동으로 사용합니다.
GOOGLE_SHEETS_WMS_SPREADSHEET_ID=

# ── WMS 상품 이미지 업로드 (Google Drive, 사용자 OAuth 2.0) ───────────────
# 없으면: 상품 이미지 촬영/교체 화면에서 "Google Drive 연결이 아직 설정되지 않았습니다" 안내.
# 설정 방법: docs/GOOGLE_DRIVE_OAUTH_SETUP.md 참고. 요청 스코프는 drive.file 하나뿐입니다
# (이 앱이 만든 파일만 접근 — 사용자의 다른 드라이브 파일에는 접근하지 않음).
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# 로컬 개발 기본값: http://localhost:3000/api/auth/google-drive/callback
# Cloudflare Quick Tunnel 주소(trycloudflare.com 등)는 재실행마다 바뀌므로 여기에 넣지 않습니다.
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=

# 선택 — 배포 환경(Vercel 등)에서 로컬 파일 저장이 불가능할 때, 최초 연결로 발급받은
# refresh token 값을 직접 넣어두면 서버 재시작/재배포 후에도 재연결 없이 계속 동작합니다.
# 이 값이 있으면 로컬 .secrets/google-drive-oauth.json보다 항상 우선합니다.
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# 선택 — 업로드 폴더를 직접 지정하고 싶을 때만 설정(비워두면 "NOID-B WMS 상품이미지" 폴더를
# 자동으로 찾거나 만듭니다).
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# ── WMS 발주확정 서류(PO_FOR_CONFIRM) 원본 자동검색 폴더 ───────────────────
# 없으면 기본값(Windows 로컬 Google Drive 동기화 폴더 예시 경로, 실제 개인 경로는 본인
# 환경에 맞게)을 코드에서 자동으로 사용합니다. 발주번호별 "PO_FOR_CONFIRM(발주번호).xlsx"
# 파일을 이 폴더에서 자동으로 찾습니다 — 원본 파일 자체는 수정/이동하지 않습니다.
# 예시(실제 값 아님): WMS_PO_FOR_CONFIRM_DIR=G:\내 드라이브\쿠팡데이터\발주서업로드양식
WMS_PO_FOR_CONFIRM_DIR=

# ── Production WMS Google Drive 읽기(서비스계정, 폴더별 뷰어 권한) ─────────
# Vercel에서는 아래 값으로 Google Drive API를 사용하며 G: 드라이브를 전혀 읽지 않습니다.
# 로컬 개발에서는 이 값들이 없을 때만 기존 G: 경로를 fallback으로 사용합니다.
GOOGLE_DRIVE_READER_CLIENT_EMAIL=
GOOGLE_DRIVE_READER_PRIVATE_KEY=
GOOGLE_DRIVE_COUPANG_SUPPLY_STATUS_FOLDER_ID=
GOOGLE_DRIVE_COUPANG_PURCHASE_ORDER_FOLDER_ID=
GOOGLE_DRIVE_PO_FOR_CONFIRM_FOLDER_ID=
GOOGLE_DRIVE_HANJIN_SHIPMENT_FOLDER_ID=
