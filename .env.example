# NOID-B OS 환경변수 예시 파일
#
# 실제 값은 이 파일에 넣지 않습니다. 이 파일을 복사해 .env.local을 만들고
# 그 안에 실제 값을 채워넣으세요 (.env.local은 .gitignore에 의해 Git에 올라가지 않습니다).
#
#   cp .env.example .env.local      (Windows PowerShell: Copy-Item .env.example .env.local)
#
# 아래 변수들이 없어도 앱은 정상적으로 실행됩니다 — 해당 기능만 "연결 필요/미설정" 상태로
# 안내 화면을 보여줄 뿐, 다른 화면이나 기존 상품등록 기능에는 영향이 없습니다.

# ── 상품등록 자동화 (Google Apps Script 웹훅) ──────────────────────────────
# 없으면: 상품등록 화면에서 구글시트 저장/조회 관련 기능이 "연결 안 됨" 상태로 동작.
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ── AI 사진 분석 / 썸네일 / 소싱 (OpenAI) ──────────────────────────────────
# 없으면: AI 분석·썸네일 생성·소싱 검색 기능이 비활성화된 상태로 동작.
OPENAI_API_KEY=

# ── WMS 발주서 읽기 전용 조회 (Google Sheets API, 서비스 계정) ────────────
# 없으면: /wms/work-center의 실제 발주서 조회가 "구글시트 연결 필요" 안내를 보여줌.
# 설정 방법: docs/GOOGLE_SHEETS_SETUP.md 참고.
GOOGLE_SHEETS_WMS_CLIENT_EMAIL=
GOOGLE_SHEETS_WMS_PRIVATE_KEY=
# 선택 — 비워두면 기본 스프레드시트 ID를 코드에서 자동으로 사용합니다.
GOOGLE_SHEETS_WMS_SPREADSHEET_ID=
